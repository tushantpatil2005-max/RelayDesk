const app = express();
const server = http.createServer(app);
const wss = new WebSocketServer({ noServer: true });

app.use(express.json({ limit: "2mb" }));

app.get("/", (_req, res) => res.type("html").send(EMBEDDED_UI));

app.post("/api/integrations/webhook-sink", (req, res) => {
  res.json({
    received: true,
    event: req.headers["x-relaydesk-event"] ?? "unknown",
    signaturePresent: Boolean(req.headers["x-relaydesk-signature"]),
  });
});

app.get("/api/bootstrap", (_req, res) => res.json(loadStore()));

app.post("/api/calls", (req, res) => {
  const { callerName, callerIdentifier, voiceName } = req.body ?? {};
  if (typeof callerName !== "string" || !callerName.trim()) {
    res.status(400).json({ error: "Caller name is required." });
    return;
  }
  const store = loadStore();
  const call: SupportCall = {
    id: `CALL-${crypto.randomUUID().slice(0, 6).toUpperCase()}`,
    callerName: callerName.trim(),
    callerIdentifier: typeof callerIdentifier === "string" ? callerIdentifier.trim() : "",
    voiceName: ["Kore", "Zephyr", "Puck", "Charon", "Fenrir"].includes(voiceName)
      ? voiceName
      : "Kore",
    status: "active",
    startedAt: new Date().toISOString(),
    durationSeconds: 0,
    firstResponseLatencyMs: null,
    interruptionCount: 0,
    state: {
      verifiedAccount: null,
      retrievedArticles: [],
      createdTicketIds: [],
      scheduledAppointmentIds: [],
      handoffId: null,
    },
    transcript: [],
    toolLogs: [],
    evaluation: null,
  };
  store.calls.unshift(call);
  saveStore(store);
  res.status(201).json({ call });
});

app.post("/api/calls/:id/evaluate", async (req, res) => {
  const store = loadStore();
  const call = store.calls.find((c) => c.id === req.params.id);
  if (!call) {
    res.status(404).json({ error: "Call not found." });
    return;
  }
  try {
    const evaluation = await evaluateCallQuality(call);
    call.evaluation = evaluation;
    if (call.status === "active") call.status = "completed";
    saveStore(store);
    res.json({ call, evaluation });
  } catch (err) {
    res.status(500).json({
      error: err instanceof Error ? err.message : "Evaluation failed.",
    });
  }
});

app.post("/api/webhooks/test", async (_req, res) => {
  const log = await dispatchWebhook("webhook.test", { ping: true });
  res.json({ log });
});

server.on("upgrade", (req, socket, head) => {
  if ((req.url ?? "").split("?")[0] === "/ws/support") {
    wss.handleUpgrade(req, socket, head, (ws) => wss.emit("connection", ws, req));
  }
});

wss.on("connection", (clientWs: WebSocket) => {
  let activeCallId: string | null = null;
  let liveSession: Awaited<ReturnType<GoogleGenAI["live"]["connect"]>> | null = null;
  let pendingCustomer = "";
  let pendingAgent = "";
  let startedMs = 0;
  let firstAudio = false;

  const send = (obj: Record<string, unknown>) => {
    if (clientWs.readyState === WebSocket.OPEN) {
      clientWs.send(JSON.stringify(obj));
    }
  };

  const commitTurn = (
    speaker: "agent" | "customer",
    text: string,
    interrupted = false
  ) => {
    const clean = text.trim();
    if (!clean || !activeCallId) return;
    const store = loadStore();
    const call = store.calls.find((c) => c.id === activeCallId);
    if (!call) return;
    const entry: TranscriptEntry = {
      id: `turn-${crypto.randomUUID().slice(0, 8)}`,
      speaker,
      text: clean,
      timestamp: new Date().toISOString(),
      interrupted,
    };
    call.transcript.push(entry);
    if (interrupted) call.interruptionCount += 1;
    saveStore(store);
    send({ type: "transcript_committed", entry });
  };

  const flush = (interrupted = false) => {
    if (pendingCustomer.trim()) {
      commitTurn("customer", pendingCustomer, false);
      pendingCustomer = "";
    }
    if (pendingAgent.trim()) {
      commitTurn("agent", pendingAgent, interrupted);
      pendingAgent = "";
    }
  };

  const closeLive = () => {
    if (liveSession) {
      try {
        liveSession.close();
      } catch {
        // Ignore
      }
      liveSession = null;
    }
  };

  const runTool = async (
    name: string,
    args: Record<string, unknown>
  ): Promise<Record<string, unknown>> => {
    const t0 = Date.now();
    const store = loadStore();
    const call = store.calls.find((c) => c.id === activeCallId);
    if (!call) return { error: "Call not found" };

    let result: Record<string, unknown> = {};
    let summary = "";
    let success = true;

    try {
      if (name === "lookup_account") {
        const q = String(args.query ?? "").toLowerCase();
        const match = store.accounts.find(
          (a) =>
            a.id.toLowerCase() === q ||
            a.email.toLowerCase().includes(q) ||
            a.contactName.toLowerCase().includes(q) ||
            a.companyName.toLowerCase().includes(q)
        );
        if (match) {
          call.state.verifiedAccount = match;
          result = { found: true, account: match };
          summary = `Verified ${match.id} (${match.companyName})`;
        } else {
          result = { found: false };
          summary = `No account matched "${args.query}"`;
        }
      } else if (name === "search_knowledge_base") {
        const hits = await searchKnowledgeBase(
          String(args.query ?? ""),
          typeof args.category === "string" ? args.category : undefined
        );
        for (const h of hits) {
          if (!call.state.retrievedArticles.some((x) => x.id === h.article.id)) {
            call.state.retrievedArticles.push({
              id: h.article.id,
              title: h.article.title,
              score: h.score,
            });
          }
        }
        result = {
          articles: hits.map((h) => ({
            id: h.article.id,
            title: h.article.title,
            content: h.article.content,
            score: h.score,
          })),
        };
        summary = `Retrieved ${hits.map((h) => h.article.id).join(", ")}`;
      } else if (name === "create_support_ticket") {
        const ticket: SupportTicket = {
          id: `TKT-${Math.floor(1000 + Math.random() * 8999)}`,
          callId: call.id,
          accountId: String(args.accountId || call.state.verifiedAccount?.id || ""),
          customerName: call.state.verifiedAccount?.contactName ?? call.callerName,
          subject: String(args.subject ?? "Support request"),
          description: String(args.description ?? ""),
          category: String(args.category ?? "General"),
          priority: (["Low", "Medium", "High", "Urgent"].includes(String(args.priority))
            ? args.priority
            : "Medium") as TicketPriority,
          status: "Open",
          createdAt: new Date().toISOString(),
        };
        store.tickets.unshift(ticket);
        call.state.createdTicketIds.push(ticket.id);
        saveStore(store);
        await dispatchWebhook("ticket.created", { ticket });
        result = { created: true, ticketId: ticket.id };
        summary = `Created ${ticket.id} (${ticket.priority})`;
      } else if (name === "schedule_appointment") {
        const apt: ScheduledAppointment = {
          id: `APT-${Math.floor(1000 + Math.random() * 8999)}`,
          callId: call.id,
          accountId: String(args.accountId || call.state.verifiedAccount?.id || ""),
          customerName: call.state.verifiedAccount?.contactName ?? call.callerName,
          topic: String(args.topic ?? "Consultation"),
          specialistType: String(args.specialistType ?? "Solutions Engineering"),
          date: String(args.date ?? "Next business day"),
          timeSlot: String(args.timeSlot ?? "14:00 UTC"),
          status: "Confirmed",
          createdAt: new Date().toISOString(),
        };
        store.appointments.unshift(apt);
        call.state.scheduledAppointmentIds.push(apt.id);
        saveStore(store);
        await dispatchWebhook("appointment.scheduled", { appointment: apt });
        result = { confirmed: true, appointmentId: apt.id };
        summary = `Booked ${apt.id} (${apt.date} ${apt.timeSlot})`;
      } else if (name === "transfer_to_human_agent") {
        const handoff: HumanHandoffPacket = {
          id: `HND-${Math.floor(1000 + Math.random() * 8999)}`,
          callId: call.id,
          accountId: call.state.verifiedAccount?.id ?? null,
          customerName: call.state.verifiedAccount?.contactName ?? call.callerName,
          department: String(args.department ?? "Tier 2 Technical"),
          urgency: (["Low", "Medium", "High", "Critical"].includes(String(args.urgency))
            ? args.urgency
            : "High") as HumanHandoffPacket["urgency"],
          reason: String(args.reason ?? "Escalated case"),
          summaryForAgent: String(args.summaryForAgent ?? ""),
          verifiedAccountSnapshot: call.state.verifiedAccount,
          consultedArticleTitles: call.state.retrievedArticles.map((a) => a.title),
          relatedTicketIds: [...call.state.createdTicketIds],
          relatedAppointmentIds: [...call.state.scheduledAppointmentIds],
          status: "Queued",
          assignedAgent: null,
          agentNotes: [],
          createdAt: new Date().toISOString(),
        };
        store.handoffs.unshift(handoff);
        call.state.handoffId = handoff.id;
        call.status = "escalated";
        saveStore(store);
        await dispatchWebhook("handoff.escalated", { handoff });
        result = { transferred: true, handoffId: handoff.id, contextAttached: true };
        summary = `Escalated ${handoff.id} to ${handoff.department}`;
      }
    } catch (err) {
      success = false;
      result = { error: err instanceof Error ? err.message : "Tool error" };
      summary = String(result.error);
    }

    const latest = loadStore();
    const latestCall = latest.calls.find((c) => c.id === activeCallId);
    if (latestCall) {
      latestCall.state = call.state;
      latestCall.status = call.status;
      const toolLog: ToolExecutionLog = {
        id: `tool-${crypto.randomUUID().slice(0, 8)}`,
        toolName: name,
        args,
        resultSummary: summary,
        latencyMs: Date.now() - t0,
        success,
        timestamp: new Date().toISOString(),
      };
      latestCall.toolLogs.push(toolLog);
      saveStore(latest);
      send({ type: "tool_executed", toolLog, state: latestCall.state });
    }
    return result;
  };

  clientWs.on("message", async (raw) => {
    let msg: { type?: string; callId?: string; audio?: string; text?: string; durationSeconds?: number };
    try {
      msg = JSON.parse(raw.toString());
    } catch {
      return;
    }

    if (msg.type === "start" && msg.callId) {
      const call = loadStore().calls.find((c) => c.id === msg.callId);
      if (!call) return;
      activeCallId = call.id;
      startedMs = Date.now();
      firstAudio = false;
      closeLive();

      try {
        const ai = getClient();
        const conn = await ai.live.connect({
          model: "gemini-3.8-live",
          config: {
            responseModalities: [Modality.AUDIO],
            speechConfig: {
              voiceConfig: { prebuiltVoiceConfig: { voiceName: call.voiceName } },
            },
            inputAudioTranscription: {},
            outputAudioTranscription: {},
            systemInstruction:
              "You are an enterprise voice support specialist for RelayDesk Cloud. Verify customer accounts via lookup_account, always check search_knowledge_base before quoting policies, create tickets via create_support_ticket, schedule callbacks via schedule_appointment, and escalate complex or security cases via transfer_to_human_agent with full context. Maintain conversation state across tool calls and yield immediately when interrupted.",
            tools: [{ functionDeclarations: TOOLS }],
          },
          callbacks: {
            onopen: () => send({ type: "ready" }),
            onmessage: async (message: LiveServerMessage) => {
              const c = message.serverContent;
              if (c?.inputTranscription?.text) {
                if (pendingAgent.trim()) {
                  commitTurn("agent", pendingAgent, false);
                  pendingAgent = "";
                }
                pendingCustomer += c.inputTranscription.text;
              }
              if (c?.outputTranscription?.text) {
                if (pendingCustomer.trim()) {
                  commitTurn("customer", pendingCustomer, false);
                  pendingCustomer = "";
                }
                pendingAgent += c.outputTranscription.text;
              }
              for (const p of c?.modelTurn?.parts ?? []) {
                if (p.inlineData?.data) {
                  if (!firstAudio && activeCallId) {
                    firstAudio = true;
                    const s = loadStore();
                    const rec = s.calls.find((x) => x.id === activeCallId);
                    if (rec) {
                      rec.firstResponseLatencyMs = Date.now() - startedMs;
                      saveStore(s);
                    }
                  }
                  send({ type: "audio", audio: p.inlineData.data });
                }
              }
              if (c?.interrupted) {
                if (pendingAgent.trim()) {
                  commitTurn("agent", pendingAgent, true);
                  pendingAgent = "";
                }
                send({ type: "interrupted" });
              }
              if (c?.turnComplete && pendingAgent.trim()) {
                commitTurn("agent", pendingAgent, false);
                pendingAgent = "";
              }
              if (message.toolCall?.functionCalls?.length && liveSession) {
                const responses = [];
                for (const fc of message.toolCall.functionCalls) {
                  const res = await runTool(
                    fc.name ?? "unknown",
                    (fc.args ?? {}) as Record<string, unknown>
                  );
                  responses.push({ id: fc.id, name: fc.name, response: res });
                }
                liveSession?.sendToolResponse({ functionResponses: responses });
              }
            },
            onerror: (err: unknown) =>
              send({
                type: "error",
                message: err instanceof Error ? err.message : "Voice error",
              }),
          },
        });
        liveSession = conn;
        liveSession.sendRealtimeInput({
          text: `Incoming call from ${call.callerName} (${call.callerIdentifier || "no ID"}). Greet them concisely, look up their account if an ID is present, and ask how you can help.`,
        });
      } catch (err) {
        send({
          type: "error",
          message: err instanceof Error ? err.message : "Connection failed",
        });
      }
    } else if (msg.type === "audio" && msg.audio && liveSession) {
      liveSession.sendRealtimeInput({
        audio: { data: msg.audio, mimeType: "audio/pcm;rate=16000" },
      });
    } else if (msg.type === "text" && msg.text && liveSession) {
      flush(false);
      commitTurn("customer", msg.text, false);
      liveSession.sendRealtimeInput({ text: msg.text });
    } else if (msg.type === "manual_interrupt") {
      if (pendingAgent.trim()) {
        commitTurn("agent", pendingAgent, true);
        pendingAgent = "";
      }
      send({ type: "interrupted" });
    } else if (msg.type === "end") {
      flush(false);
      if (activeCallId && typeof msg.durationSeconds === "number") {
        const s = loadStore();
        const rec = s.calls.find((x) => x.id === activeCallId);
        if (rec) {
          rec.durationSeconds = Math.floor(msg.durationSeconds);
          if (rec.status === "active") rec.status = "completed";
          saveStore(s);
        }
      }
      closeLive();
    }
  });

  clientWs.on("close", () => {
    flush(false);
    closeLive();
  });
});

server.listen(PORT, "0.0.0.0", () => {
  console.log(`Enterprise Customer Support Voice Platform running on http://localhost:${PORT}`);
});
