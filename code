const PORT = Number(process.env.PORT || 3001);
const STORE_PATH = path.resolve(process.cwd(), "support_platform_store.json");

function loadStore(): StoreData {
  if (!fs.existsSync(STORE_PATH)) {
    const initial: StoreData = {
      accounts: SEED_ACCOUNTS,
      knowledgeBase: SEED_KB,
      tickets: [],
      appointments: [],
      handoffs: [],
      calls: [],
      webhooks: {
        crmUrl: process.env.CRM_WEBHOOK_URL || "",
        ticketingUrl: process.env.TICKET_WEBHOOK_URL || "",
        escalationUrl: process.env.ESCALATION_WEBHOOK_URL || "",
        enabled: true,
      },
      webhookLogs: [],
    };
    fs.writeFileSync(STORE_PATH, JSON.stringify(initial, null, 2), "utf-8");
    return initial;
  }
  try {
    return JSON.parse(fs.readFileSync(STORE_PATH, "utf-8")) as StoreData;
  } catch {
    return {
      accounts: SEED_ACCOUNTS,
      knowledgeBase: SEED_KB,
      tickets: [],
      appointments: [],
      handoffs: [],
      calls: [],
      webhooks: { crmUrl: "", ticketingUrl: "", escalationUrl: "", enabled: true },
      webhookLogs: [],
    };
  }
}

function saveStore(store: StoreData): void {
  fs.writeFileSync(STORE_PATH, JSON.stringify(store, null, 2), "utf-8");
}

function getClient(): GoogleGenAI {
  const apiKey = process.env.GEMINI_API_KEY;
  if (!apiKey) {
    throw new Error("Missing GEMINI_API_KEY environment variable.");
  }
  return new GoogleGenAI({ apiKey });
}

// ============================================================================
// Hybrid Retrieval Engine (Semantic Embeddings + Lexical Scoring)
// ============================================================================

const vectorCache = new Map<string, number[]>();

function tokenize(s: string): string[] {
  return s
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, " ")
    .split(/\s+/)
    .filter((w) => w.length > 1);
}

function lexicalScore(query: string, article: KnowledgeArticle): number {
  const q = tokenize(query);
  if (q.length === 0) return 0;
  const hay = tokenize(
    `${article.title} ${article.category} ${article.tags.join(" ")} ${article.content}`
  );
  const titleSet = new Set(tokenize(`${article.title} ${article.tags.join(" ")}`));
  const freq = new Map<string, number>();
  for (const w of hay) freq.set(w, (freq.get(w) ?? 0) + 1);
  let score = 0;
  for (const w of q) {
    if (titleSet.has(w)) score += 3;
    if (freq.has(w)) score += Math.min(3, freq.get(w) ?? 0);
  }
  return score / (q.length * 5);
}

function cosine(a: number[], b: number[]): number {
  const n = Math.min(a.length, b.length);
  let dot = 0;
  let ma = 0;
  let mb = 0;
  for (let i = 0; i < n; i++) {
    dot += a[i] * b[i];
    ma += a[i] * a[i];
    mb += b[i] * b[i];
  }
  const d = Math.sqrt(ma) * Math.sqrt(mb);
  return d > 0 ? dot / d : 0;
}

async function searchKnowledgeBase(
  query: string,
  category?: string
): Promise<{ article: KnowledgeArticle; score: number; method: string }[]> {
  const store = loadStore();
  const filtered = category
    ? store.knowledgeBase.filter((a) =>
        a.category.toLowerCase().includes(category.toLowerCase())
      )
    : store.knowledgeBase;
  const pool = filtered.length > 0 ? filtered : store.knowledgeBase;

  let method = "lexical";
  let qVec: number[] | null = null;
  try {
    const ai = getClient();
    const uncached = pool.filter((a) => !vectorCache.has(`${a.id}:${a.updatedAt}`));
    const res = await ai.models.embedContent({
      model: "gemini-embedding-2",
      contents: [
        query,
        ...uncached.map((a) => `${a.title}\n${a.tags.join(", ")}\n${a.content}`),
      ],
    });
    const embs = res.embeddings ?? [];
    if (embs[0]?.values) {
      qVec = embs[0].values;
      uncached.forEach((a, i) => {
        const v = embs[i + 1]?.values;
        if (v) vectorCache.set(`${a.id}:${a.updatedAt}`, v);
      });
      method = "hybrid_semantic";
    }
  } catch {
    method = "lexical";
  }

  return pool
    .map((article) => {
      const lex = lexicalScore(query, article);
      const v = vectorCache.get(`${article.id}:${article.updatedAt}`);
      const sem = qVec && v ? Math.max(0, cosine(qVec, v)) : 0;
      const combined = method === "hybrid_semantic" ? sem * 0.72 + Math.min(1, lex) * 0.28 : lex;
      return { article, score: Number(combined.toFixed(3)), method };
    })
    .sort((a, b) => b.score - a.score)
    .slice(0, 3);
}

// ============================================================================
// Signed External Webhook Dispatcher
// ============================================================================

function isAllowedWebhook(rawUrl: string): boolean {
  try {
    const u = new URL(rawUrl);
    if (u.protocol === "https:") {
      const h = u.hostname.toLowerCase();
      if (
        h === "localhost" ||
        h === "127.0.0.1" ||
        h.startsWith("10.") ||
        h.startsWith("192.168.") ||
        h.startsWith("169.254.") ||
        h === "::1"
      ) {
        return false;
      }
      return true;
    }
    return (
      u.protocol === "http:" &&
      (u.hostname === "127.0.0.1" || u.hostname === "localhost") &&
      Number(u.port || 80) === PORT &&
      u.pathname === "/api/integrations/webhook-sink"
    );
  } catch {
    return false;
  }
}

async function dispatchWebhook(
  eventType: string,
  payload: Record<string, unknown>,
  explicitUrl?: string
): Promise<WebhookDeliveryLog | null> {
  const store = loadStore();
  if (!store.webhooks.enabled && !explicitUrl) return null;

  let target = explicitUrl || "";
  if (!target) {
    if (eventType === "ticket.created") target = store.webhooks.ticketingUrl;
    else if (eventType === "appointment.scheduled") target = store.webhooks.crmUrl;
    else if (eventType === "handoff.escalated") target = store.webhooks.escalationUrl;
  }
  if (!target) {
    target = `http://127.0.0.1:${PORT}/api/integrations/webhook-sink`;
  }
  if (!isAllowedWebhook(target)) {
    const blocked: WebhookDeliveryLog = {
      id: `whk-${crypto.randomUUID().slice(0, 8)}`,
      eventType,
      targetUrl: target,
      statusCode: null,
      latencyMs: 0,
      success: false,
      error: "Blocked URL",
      timestamp: new Date().toISOString(),
    };
    store.webhookLogs.unshift(blocked);
    saveStore(store);
    return blocked;
  }

  const started = Date.now();
  const body = JSON.stringify({
    event: eventType,
    timestamp: new Date().toISOString(),
    data: payload,
  });
  const sig = crypto
    .createHmac("sha256", process.env.WEBHOOK_SIGNING_SECRET || "relaydesk-secret")
    .update(body)
    .digest("hex");

  try {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 4500);
    const resp = await fetch(target, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-RelayDesk-Event": eventType,
        "X-RelayDesk-Signature": `sha256=${sig}`,
      },
      body,
      signal: ctrl.signal,
    });
    clearTimeout(timer);

    const log: WebhookDeliveryLog = {
      id: `whk-${crypto.randomUUID().slice(0, 8)}`,
      eventType,
      targetUrl: target,
      statusCode: resp.status,
      latencyMs: Date.now() - started,
      success: resp.ok,
      timestamp: new Date().toISOString(),
    };
    const latest = loadStore();
    latest.webhookLogs.unshift(log);
    latest.webhookLogs = latest.webhookLogs.slice(0, 50);
    saveStore(latest);
    return log;
  } catch (err) {
    const log: WebhookDeliveryLog = {
      id: `whk-${crypto.randomUUID().slice(0, 8)}`,
      eventType,
      targetUrl: target,
      statusCode: null,
      latencyMs: Date.now() - started,
      success: false,
      error: err instanceof Error ? err.message : "Delivery failed",
      timestamp: new Date().toISOString(),
    };
    const latest = loadStore();
    latest.webhookLogs.unshift(log);
    saveStore(latest);
    return log;
  }
}

