async function evaluateCallQuality(call: SupportCall): Promise<CallQualityEvaluation> {
  if (call.transcript.length === 0) {
    throw new Error("Transcript is empty.");
  }
  const ai = getClient();
  const response = await ai.models.generateContent({
    model: "gemini-4-hydrogen",
    contents: [
      `Call ${call.id} | Caller: ${call.callerName} | Status: ${call.status} | Interruptions: ${call.interruptionCount}`,
      `Tools: ${call.toolLogs.map((t) => `${t.toolName}(${t.latencyMs}ms): ${t.resultSummary}`).join(" ; ") || "None"}`,
      "Transcript:",
      ...call.transcript.map((t) => `[${t.speaker}${t.interrupted ? " interrupted" : ""}]: ${t.text}`),
      "Evaluate across 5 QA dimensions: Resolution & Accuracy, Knowledge Base Grounding, Tool Execution Precision, Empathy & Tone, and Escalation & Handoff Hygiene.",
    ].join("\n"),
    config: {
      systemInstruction:
        "You are an enterprise contact-center QA auditor evaluating voice support calls strictly from transcript and tool logs.",
      responseMimeType: "application/json",
      responseSchema: {
        type: Type.OBJECT,
        properties: {
          overallScore: { type: Type.INTEGER },
          sentiment: { type: Type.STRING },
          firstCallResolution: { type: Type.BOOLEAN },
          summary: { type: Type.STRING },
          dimensions: {
            type: Type.ARRAY,
            items: {
              type: Type.OBJECT,
              properties: {
                name: { type: Type.STRING },
                score: { type: Type.INTEGER },
                rationale: { type: Type.STRING },
              },
              required: ["name", "score", "rationale"],
            },
          },
          policyAdherenceNotes: { type: Type.ARRAY, items: { type: Type.STRING } },
          coachingRecommendations: { type: Type.ARRAY, items: { type: Type.STRING } },
        },
        required: [
          "overallScore",
          "sentiment",
          "firstCallResolution",
          "summary",
          "dimensions",
          "policyAdherenceNotes",
          "coachingRecommendations",
        ],
      },
    },
  });

  const parsed = JSON.parse((response.text ?? "{}").trim()) as Omit<
    CallQualityEvaluation,
    "generatedAt"
  >;
  return {
    ...parsed,
    overallScore: Math.max(0, Math.min(100, Math.round(parsed.overallScore || 0))),
    generatedAt: new Date().toISOString(),
  };
}

