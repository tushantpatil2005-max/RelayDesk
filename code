          <div class="row" style="margin-top:24px">
            <button id="startBtn" class="primary">Start Support Call</button>
            <button id="testWhBtn">Test Signed Webhook</button>
          </div>
        </div>
      </div>
    </div>

    <div id="liveWrap" class="grid" style="display:none">
      <div class="panel">
        <div class="row" style="justify-content:space-between;margin-bottom:8px">
          <strong id="callTitle">Active Call</strong>
          <span id="timer" class="mono" style="font-size:12px">00:00</span>
        </div>
        <canvas id="wave"></canvas>
        <div class="row" style="margin:12px 0">
          <button id="muteBtn">Mute Mic</button>
          <button id="interruptBtn">Interrupt</button>
          <button id="endBtn" class="danger">End & Run QA</button>
        </div>
        <div class="row">
          <input id="txtInput" placeholder="Optional keyboard caller input..." style="flex:1" />
          <button id="sendTxtBtn">Send</button>
        </div>
        <h3 style="margin:16px 0 8px;font-size:14px">Live Transcript</h3>
        <div id="transcript" class="scroll"></div>
      </div>

      <div class="panel">
        <h3 style="margin:0 0 8px;font-size:15px">Live Conversation State & Tool Calls</h3>
        <pre id="stateBox">Waiting for tool calls...</pre>
        <h3 style="margin:14px 0 8px;font-size:14px">Tool Execution Log</h3>
        <div id="toolBox" class="scroll"></div>
      </div>
    </div>

    <div id="qaPanel" class="panel" style="display:none">
      <h3 style="margin:0 0 8px">Quality Evaluation & Call Telemetry</h3>
      <pre id="qaOut"></pre>
    </div>

    <div class="grid">
      <div class="panel">
        <h3 style="margin:0 0 8px">Tickets, Appointments & Human Handoffs</h3>
        <div id="opsSummary" class="scroll" style="color:#475569">Loading...</div>
      </div>
      <div class="panel">
        <h3 style="margin:0 0 8px">Analytics & Webhook Deliveries</h3>
        <div id="analyticsSummary" class="scroll" style="color:#475569">Loading...</div>
      </div>
    </div>
  </main>

  <script>
    let activeCall = null, ws = null, inCtx = null, outCtx = null, stream = null, proc = null;
    let inAnalyser = null, outAnalyser = null, nextStart = 0, sources = new Set();
    let muted = false, elapsed = 0, timer = null;
    const $ = (id) => document.getElementById(id);

    function to16kBase64(input, sr) {
      const ratio = sr / 16000;
      const len = Math.max(1, Math.floor(input.length / ratio));
      const pcm = new Int16Array(len);
      for (let i = 0; i < len; i++) {
        const s = Math.max(-1, Math.min(1, input[Math.floor(i * ratio)] || 0));
        pcm[i] = s < 0 ? s * 0x8000 : s * 0x7fff;
      }
      const b = new Uint8Array(pcm.buffer);
      let bin = "";
      for (let i = 0; i < b.length; i += 0x8000) bin += String.fromCharCode(...b.subarray(i, i + 0x8000));
      return btoa(bin);
    }

    function stopAudio() {
      sources.forEach((s) => { try { s.stop(); } catch {} });
      sources.clear();
      nextStart = outCtx ? outCtx.currentTime : 0;
    }

    function play24k(b64) {
      if (!outCtx || !outAnalyser) return;
      if (outCtx.state === "suspended") outCtx.resume();
      const bin = atob(b64);
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      const view = new DataView(bytes.buffer);
      const floats = new Float32Array(Math.floor(bytes.byteLength / 2));
      for (let i = 0; i < floats.length; i++) floats[i] = view.getInt16(i * 2, true) / 32768;
      const buf = outCtx.createBuffer(1, floats.length, 24000);
      buf.copyToChannel(floats, 0);
      const src = outCtx.createBufferSource();
      src.buffer = buf;
      src.connect(outAnalyser);
      const at = Math.max(outCtx.currentTime, nextStart);
      src.start(at);
      nextStart = at + buf.duration;
      sources.add(src);
      src.onended = () => sources.delete(src);
    }

    function teardown() {
      stopAudio();
      clearInterval(timer);
      if (proc) { proc.disconnect(); proc = null; }
      if (stream) { stream.getTracks().forEach((t) => t.stop()); stream = null; }
      if (inCtx) { inCtx.close(); inCtx = null; }
      if (outCtx) { outCtx.close(); outCtx = null; }
      if (ws) { ws.close(); ws = null; }
    }

    async function refresh() {
      const res = await fetch("/api/bootstrap");
      const data = await res.json();
      $("opsSummary").innerHTML =
        "<div><strong>Tickets (" + data.tickets.length + "):</strong> " + (data.tickets.map((t) => t.id + " [" + t.priority + "] " + t.subject).join("<br/>") || "None") + "</div>" +
        "<div style='margin-top:8px'><strong>Human Handoffs (" + data.handoffs.length + "):</strong> " + (data.handoffs.map((h) => h.id + " → " + h.department + " (" + h.urgency + ")").join("<br/>") || "None") + "</div>" +
        "<div style='margin-top:8px'><strong>Appointments (" + data.appointments.length + "):</strong> " + (data.appointments.map((a) => a.id + " " + a.specialistType + " " + a.date + " " + a.timeSlot).join("<br/>") || "None") + "</div>";
      $("analyticsSummary").innerHTML =
        "<div><strong>Recorded Calls:</strong> " + data.calls.length + "</div>" +
        "<div style='margin-top:8px'><strong>Webhook Deliveries (" + data.webhookLogs.length + "):</strong><br/>" +
        (data.webhookLogs.slice(0, 6).map((w) => w.eventType + " → HTTP " + (w.statusCode || "ERR") + " (" + w.latencyMs + "ms)").join("<br/>") || "None") + "</div>";
    }

    $("startBtn").onclick = async () => {
      teardown();
      const res = await fetch("/api/calls", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          callerName: $("callerName").value.trim(),
          callerIdentifier: $("callerId").value.trim(),
          voiceName: $("voice").value
        })
      });
      const { call } = await res.json();
      activeCall = call;
      elapsed = 0;
      $("liveWrap").style.display = "grid";
      $("callTitle").textContent = call.id + " — " + call.callerName;
      $("transcript").innerHTML = "";
      $("toolBox").innerHTML = "";
      $("stateBox").textContent = JSON.stringify(call.state, null, 2);
      $("status").textContent = "Connecting...";

      outCtx = new AudioContext({ sampleRate: 24000 });
      outAnalyser = outCtx.createAnalyser();
      outAnalyser.connect(outCtx.destination);
      nextStart = outCtx.currentTime;

      try {
        stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        inCtx = new AudioContext({ sampleRate: 16000 });
        const src = inCtx.createMediaStreamSource(stream);
        inAnalyser = inCtx.createAnalyser();
        proc = inCtx.createScriptProcessor(4096, 1, 1);
        src.connect(inAnalyser);
        inAnalyser.connect(proc);
        proc.connect(inCtx.destination);
      } catch {
        $("status").textContent = "Mic unavailable (keyboard mode)";
      }

      const proto = location.protocol === "https:" ? "wss:" : "ws:";
      ws = new WebSocket(proto + "//" + location.host + "/ws/support");
      ws.onopen = () => ws.send(JSON.stringify({ type: "start", callId: call.id }));
      ws.onmessage = (e) => {
        const msg = JSON.parse(e.data);
        if (msg.type === "ready") {
          $("status").textContent = "Live";
          timer = setInterval(() => {
            elapsed++;
            $("timer").textContent = String(Math.floor(elapsed / 60)).padStart(2, "0") + ":" + String(elapsed % 60).padStart(2, "0");
          }, 1000);
          if (proc && inCtx) {
            const sr = inCtx.sampleRate;
            proc.onaudioprocess = (ev) => {
              if (muted || !ws || ws.readyState !== 1) return;
              ws.send(JSON.stringify({ type: "audio", audio: to16kBase64(ev.inputBuffer.getChannelData(0), sr) }));
            };
          }
        } else if (msg.type === "audio") {
          play24k(msg.audio);
        } else if (msg.type === "transcript_committed") {
          const d = document.createElement("div");
          d.style.marginBottom = "8px";
          d.innerHTML = "<strong>" + msg.entry.speaker + (msg.entry.interrupted ? " (interrupted)" : "") + ":</strong> " + msg.entry.text.replace(/</g, "&lt;");
          $("transcript").appendChild(d);
          $("transcript").scrollTop = $("transcript").scrollHeight;
        } else if (msg.type === "tool_executed") {
          $("stateBox").textContent = JSON.stringify(msg.state, null, 2);
          const row = document.createElement("div");
          row.style.marginBottom = "6px";
          row.textContent = msg.toolLog.toolName + " (" + msg.toolLog.latencyMs + "ms): " + msg.toolLog.resultSummary;
          $("toolBox").appendChild(row);
          refresh();
        } else if (msg.type === "interrupted") {
          stopAudio();
          $("status").textContent = "Interrupted — Listening";
        } else if (msg.type === "error") {
          $("status").textContent = "Error: " + msg.message;
        }
      };
    };

    $("muteBtn").onclick = () => { muted = !muted; $("muteBtn").textContent = muted ? "Unmute Mic" : "Mute Mic"; };
    $("interruptBtn").onclick = () => { stopAudio(); if (ws && ws.readyState === 1) ws.send(JSON.stringify({ type: "manual_interrupt" })); };
    $("sendTxtBtn").onclick = () => {
      const t = $("txtInput").value.trim();
      if (!t || !ws || ws.readyState !== 1) return;
      stopAudio();
      ws.send(JSON.stringify({ type: "text", text: t }));
      $("txtInput").value = "";
    };
    $("endBtn").onclick = async () => {
      if (!activeCall) return;
      if (ws && ws.readyState === 1) ws.send(JSON.stringify({ type: "end", durationSeconds: elapsed }));
      teardown();
      $("status").textContent = "Evaluating QA...";
      const res = await fetch("/api/calls/" + activeCall.id + "/evaluate", { method: "POST" });
      const data = await res.json();
      $("qaPanel").style.display = "block";
      $("qaOut").textContent = JSON.stringify(data, null, 2);
      $("status").textContent = "Completed";
      refresh();
    };
    $("testWhBtn").onclick = async () => {
      await fetch("/api/webhooks/test", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" });
      refresh();
    };

    (function loop() {
      const c = $("wave"), ctx = c.getContext("2d"), bins = new Uint8Array(64);
      function draw() {
        if (c.width !== c.clientWidth) { c.width = c.clientWidth || 400; c.height = 96; }
        ctx.clearRect(0, 0, c.width, c.height);
        const a = sources.size > 0 ? outAnalyser : inAnalyser;
        if (a) a.getByteFrequencyData(bins); else bins.fill(0);
        const n = 40, w = (c.width - (n - 1) * 4) / n;
        ctx.fillStyle = sources.size > 0 ? "#1d4ed8" : "#15803d";
        for (let i = 0; i < n; i++) {
          const h = Math.max(3, (bins[i + 1] / 255) * 80);
          ctx.fillRect(i * (w + 4), (96 - h) / 2, w, h);
        }
        requestAnimationFrame(draw);
      }
      requestAnimationFrame(draw);
    })();

    refresh();
  </script>
</body>
</html>`;

